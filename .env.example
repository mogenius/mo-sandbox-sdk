# Copy to .env for local examples. Never commit real values.
MOGENIUS_API_KEY=mo_pat:...
MOGENIUS_API_URL=https://platform-api.dev.mogenius.com
MOGENIUS_ORGANIZATION_ID=
MOGENIUS_CLUSTER_ID=
# Namespace the sandbox chart puts sandboxes in (sandboxes.namespace.name); default agent-sandbox
MOGENIUS_SANDBOX_NAMESPACE=agent-sandbox

# Optional, for examples/fs.ts: key with the cluster-viewer role (reads pass, writes are 403)
MOGENIUS_VIEWER_API_KEY=
